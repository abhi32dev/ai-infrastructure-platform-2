    classDef endNode fill:#E8EBEE,stroke:#8993A0,stroke-width:2px
    class START startNode
    class QUANTCHECK,PCTCHECK,TRAINLOOP,BATCHLOOP,GENLOOP decisionNode
    class DONE,PROCEED endNode
