    class DEVICECHECK,EPOCHLOOP,BATCHLOOP,IMGLOOP,SCORECHECK,HASTRACKS,HASDETECT,PAIRLOOP,THRESHCHECK,ALREADYUSED decisionNode
    class MEANIOU,ALIVE endNode
