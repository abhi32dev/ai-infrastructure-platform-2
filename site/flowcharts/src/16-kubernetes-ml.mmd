    class STATUSCODE,PROBEOUTCOME,FAILTHRESH,LIVEFAILCHECK decisionNode
    class STAYREADY,PODALIVE endNode
    class NOTRAFFIC,RESTARTPOD,BUGGED,STALEHEALTHY warnNode
